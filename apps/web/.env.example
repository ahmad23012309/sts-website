# Public site URL, used for canonical links and structured data.
NEXT_PUBLIC_SITE_URL=https://sidhutravelservices.com

# "fixtures" renders the preview data and shows the preview ribbon.
# "cms" reads from WordPress and hides it.
NEXT_PUBLIC_DATA_SOURCE=fixtures

# Headless WordPress REST base, for example https://cms.sidhutravelservices.com
WORDPRESS_API_URL=

# Where validated form submissions are delivered, and the shared secret used to
# sign them. Without both, booking and lead endpoints refuse the submission
# rather than silently dropping it.
SUBMISSION_WEBHOOK_URL=
SUBMISSION_WEBHOOK_SECRET=

# Cloudflare Turnstile keys for form protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
