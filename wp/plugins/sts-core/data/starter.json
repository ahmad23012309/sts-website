  "sts_faq": [
   {
    "slug": "what-documents-do-i-need-to-rent-a-car",
    "title": "What documents do I need to rent a car?",
    "content": "A valid CNIC and a driving licence for self-drive rentals. Corporate accounts are opened against company registration documents. Exact requirements are confirmed at booking.",
    "meta": {}
   },
   {
    "slug": "what-is-the-difference-between-the-with-fuel-and-without-fue",
    "title": "What is the difference between the with-fuel and without-fuel rate?",
    "content": "The with-fuel rate includes the fuel for your trip, calculated from the distance, the vehicle's consumption and the day's fuel price. The without-fuel rate covers the vehicle alone and you fill it yourself.",
    "meta": {}
   },
   {
    "slug": "why-does-the-fare-estimate-change-from-day-to-day",
    "title": "Why does the fare estimate change from day to day?",
    "content": "Fuel prices in Pakistan are revised regularly. Every with-fuel quote is calculated against the current rate, which is published on our fuel prices page along with the date it took effect.",
    "meta": {}
   },
   {
    "slug": "can-i-rent-without-a-driver",
    "title": "Can I rent without a driver?",
    "content": "Yes. Self-drive is available on most of the fleet, subject to documents and a security deposit. Some premium vehicles are chauffeur-driven only.",
    "meta": {}
   },
   {
    "slug": "which-cities-do-you-operate-in",
    "title": "Which cities do you operate in?",
    "content": "Vehicles can be collected in our listed pick-up cities, and out-of-station travel is available nationwide.",
    "meta": {}
   }
  ],
