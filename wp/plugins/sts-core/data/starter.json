  "sts_service": [
   {
    "slug": "staff-transport",
    "title": "Staff Transport",
    "content": "A staff route is judged on the mornings it would have failed. Ours are built around that: drivers assigned to the route rather than sourced on the day, servicing planned against each registration, and a replacement vehicle when one is off the road.\n\nRoutes, pick-up points and timings are agreed once and held to. Changes go through a named contact, not a call centre, and the whole month arrives as a single itemised invoice.",
    "meta": {
     "audience": "For employers moving people to work every day",
     "summary": "Daily pick and drop on fixed routes, billed monthly against one invoice.",
     "points": "Coasters, Hiace vans and intercity coaches\nThe same drivers on the same route\nReplacement vehicle guarantee\nOne monthly invoice against your purchase order",
     "related_classes": "coaster, van, bus"
    }
   },
   {
    "slug": "corporate-fleet",
    "title": "Corporate Fleet Leasing",
    "content": "Take the vehicles you need on contract and leave the registration, servicing, repairs and replacement to us. Contracts start at a single vehicle and run from a month upwards.\n\nYou get a fixed monthly cost instead of an unpredictable one, and your people get a car that works rather than one that is overdue a service.",
    "meta": {
     "audience": "For companies that need vehicles without owning them",
     "summary": "Vehicles on contract for your executives and teams, maintained by us.",
     "points": "From one vehicle upwards\nScheduled maintenance included\nWith or without a driver\nCredit terms agreed up front",
     "related_classes": "sedan, suv, luxury"
    }
   },
   {
    "slug": "daily-rental",
    "title": "Daily Rental",
    "content": "Pick the vehicle, tell us the dates, and we deliver it or you collect it. Self-drive is available on most of the fleet against documents and a deposit; some vehicles are chauffeur-driven only.\n\nRates are published on every vehicle page, with fuel and without, so you can work out the cost before you call.",
    "meta": {
     "audience": "For anyone who needs a vehicle for a day or a week",
     "summary": "Any vehicle in the fleet by the day, with or without a driver.",
     "points": "Published rates, with and without fuel\nSelf-drive or with a driver\nDelivery to your address\nDiscounts from seven days",
     "related_classes": "economy, sedan, suv"
    }
   },
   {
    "slug": "airport-transfer",
    "title": "Airport Transfer",
    "content": "The price is agreed before the journey, so a delayed landing or a slow queue at immigration costs nothing extra. The driver waits inside with a name board.\n\nFor groups, a coaster or a Hiace meets the whole party at once rather than splitting people across taxis.",
    "meta": {
     "audience": "For arrivals, departures and guests you are meeting",
     "summary": "Fixed-price pick-up and drop-off, with the driver waiting on arrival.",
     "points": "Price fixed before the journey\nDriver waits on arrival\nGroup vehicles for larger parties\nReturn transfers arranged together",
     "related_classes": "sedan, suv, van"
    }
   },
   {
    "slug": "intercity-travel",
    "title": "Intercity Travel",
    "content": "Journeys between cities are quoted from the distance, the vehicle's own consumption and the fuel price in force that day, then shown to you as a breakdown rather than a single figure.\n\nA one-way drop and a return trip are priced differently, because on a one-way the vehicle still has to come back. The calculator shows which is which.",
    "meta": {
     "audience": "For travel between cities, one way or returning",
     "summary": "Point-to-point journeys priced on distance and the day's fuel rate.",
     "points": "Quoted before you commit\nOne-way drops and return journeys\nDriver allowance and night stay shown separately\nTolls included where we hold the route",
     "related_classes": "sedan, suv, coaster"
    }
   },
   {
    "slug": "weddings-and-events",
    "title": "Weddings and Events",
    "content": "An event needs two things from transport: a vehicle that looks right in the photographs, and enough seats to move everyone else. We cover both from the same fleet, on the same booking.\n\nTimings are planned with you beforehand, because an event is the one job where arriving late cannot be fixed afterwards.",
    "meta": {
     "audience": "For weddings, functions and corporate events",
     "summary": "Presentation vehicles and group transport for the whole occasion.",
     "points": "Executive and presentation vehicles\nCoasters and vans for guests\nTimings planned in advance\nMultiple vehicles on one booking",
     "related_classes": "luxury, convertible, coaster"
    }
   }
  ],
